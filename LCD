#include <16F887.h>
#device adc=10
#fuses HS, NOWDT, NOPROTECT, NOLVP
#use delay(clock=20000000)

#byte puerto_a = 5
#byte puerto_b = 6
#byte puerto_c = 7
#byte puerto_d = 8
#byte puerto_e = 9

#use i2c(Master, Fast=100000, sda=PIN_C4, scl=PIN_C3, force_hw)
#include "C:\Users\maico\Downloads\i2c_Flex_LCD.c.txt"

int8 estado = 1;
int8 mode = 0;             // 0: Bienvenida | 1: Menú bebidas | 2: Preparando | 3: Confirmación
int8 actualizar_lcd = 1;
int16 tiempo_bebida = 2500;
int1 flag_ext = 0;         // bandera que avisa que se presionó RB0
int1 armado = 0;           // los botones solo valen después de verlos todos sueltos

#define enter     pin_d3
#define siguiente pin_d2
#define anterior  pin_d1
#define confirmar pin_b1

// Declaración de funciones
void menu1();
void menu2();
void view();
void nombre_bebida();
void funcion_interrumpir();
void funcion_siguiente();
void funcion_anterior();
void funcion_enter();
void funcion_confirmar();
void atender_boton_rb0();
void actualizar_armado();
int1 boton_valido(int16 pin);

// Interrupción externa (Botón RB0)
#INT_EXT
void Ext_isr(void)
{
   disable_interrupts(INT_EXT);
   flag_ext = 1;
}

void main()
{
   setup_adc_ports(NO_ANALOGS);
   port_b_pullups(0x03);            // Activa pull-up en RB0 y RB1

   set_tris_b(0x0F);                // RB0-RB3 como entradas
   set_tris_d(0x0E);                // RD1, RD2, RD3 entradas; RD0 y RD4-RD7 salidas
   puerto_d = 0x00;

   delay_ms(10);
   lcd_init(0x4E, 20, 4);
   lcd_backlight_led(ON);

   ext_int_edge(H_TO_L);
   clear_interrupt(INT_EXT);
   enable_interrupts(INT_EXT);
   enable_interrupts(GLOBAL);

   while(TRUE)
   {
      atender_boton_rb0();

      // 1. MENÚ PRINCIPAL (Bienvenida)
      if(mode == 0)
      {
         if(actualizar_lcd == 1)
         {
            printf(lcd_putc,"\fDigitales 3 UPN");
            lcd_gotoxy(1, 2);
            printf(lcd_putc,"\nMenu Principal");
            lcd_gotoxy(1, 3);
            printf(lcd_putc,"\nPresione Boton Rojo");
            actualizar_lcd = 0;
         }
      }

      // 2. MENÚ INTERACTIVO DE BEBIDAS
      else if(mode == 1)
      {
         if(actualizar_lcd == 1)
         {
            menu1();
            view();
            armado = 0;             // hasta ver todos los botones sueltos, no se acepta ninguno
            actualizar_lcd = 0;
         }

         actualizar_armado();

         funcion_siguiente();
         funcion_anterior();
         funcion_enter();
      }

      // 3. MENÚ DE CONFIRMACIÓN
      else if(mode == 3)
      {
         if(actualizar_lcd == 1)
         {
            menu2();
            lcd_gotoxy(1, 2);
            nombre_bebida();
            armado = 0;             // igual que en el menú de bebidas
            actualizar_lcd = 0;
         }

         actualizar_armado();
         funcion_confirmar();
      }

      // 4. PREPARANDO BEBIDA
      else if(mode == 2)
      {
         printf(lcd_putc, "\fPreparando...");
         lcd_gotoxy(1, 2);
         nombre_bebida();

         puerto_d = (estado << 4);
         output_high(PIN_D0);

         // --- SIMULACIÓN DE BARRA GRÁFICA ---
         int16 tiempo_etapa = tiempo_bebida / 4;

         lcd_gotoxy(1, 4);
         printf(lcd_putc, "[          ] 0%%");

         delay_ms(tiempo_etapa);
         lcd_gotoxy(2, 4);
         printf(lcd_putc, "\xFF\xFF\xFF");
         lcd_gotoxy(13, 4);
         printf(lcd_putc, "25%%");

         delay_ms(tiempo_etapa);
         lcd_gotoxy(2, 4);
         printf(lcd_putc, "\xFF\xFF\xFF\xFF\xFF");
         lcd_gotoxy(13, 4);
         printf(lcd_putc, "50%%");

         delay_ms(tiempo_etapa);
         lcd_gotoxy(2, 4);
         printf(lcd_putc, "\xFF\xFF\xFF\xFF\xFF\xFF\xFF");
         lcd_gotoxy(13, 4);
         printf(lcd_putc, "75%%");

         delay_ms(tiempo_etapa);
         lcd_gotoxy(2, 4);
         printf(lcd_putc, "\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFF");
         lcd_gotoxy(12, 4);
         printf(lcd_putc, "100%%");
         delay_ms(1000);

         puerto_d = 0x00;
         printf(lcd_putc, "\fBebida lista!");
         lcd_gotoxy(1, 2);
         printf(lcd_putc, "\nGracias vuelve");
         printf(lcd_putc, "\nPronto:)");
         delay_ms(2000);

         flag_ext = 0;
         clear_interrupt(INT_EXT);
         enable_interrupts(INT_EXT);

         mode = 0;
         actualizar_lcd = 1;
      }
   }
}

// ----------------------------------------------------
// DEFINICIÓN DE FUNCIONES
// ----------------------------------------------------

// Un botón es válido solo si se mantiene presionado (nivel 0) durante ~40 ms
int1 boton_valido(int16 pin)
{
   int8 i;

   if(input(pin) == 1) return 0;

   for(i = 0; i < 8; i++)
   {
      delay_ms(5);
      if(input(pin) == 1) return 0;     // fue un pico de ruido, no una pulsación
   }
   return 1;
}

// Después de cada cambio de pantalla, espera a ver TODOS los botones sueltos
// durante 100 ms seguidos. Hasta entonces, ningún botón de selección funciona.
void actualizar_armado(void)
{
   int8 i;

   if(armado == 0)
   {
      for(i = 0; i < 10; i++)
      {
         if(input(siguiente) == 0) return;
         if(input(anterior)  == 0) return;
         if(input(enter)     == 0) return;
         if(input(confirmar) == 0) return;
         delay_ms(10);
      }
      armado = 1;
   }
}

// Antirrebote del botón RB0 (fuera de la interrupción)
void atender_boton_rb0(void)
{
   if(flag_ext == 1)
   {
      delay_ms(20);
      if(input(PIN_B0) == 0)
      {
         funcion_interrumpir();
         while(input(PIN_B0) == 0);
      }
      delay_ms(30);
      flag_ext = 0;
      clear_interrupt(INT_EXT);
      enable_interrupts(INT_EXT);
   }
}

void funcion_interrumpir(void)
{
   if(mode == 0)
   {
      mode = 1;
      estado = 1;
   }
   else if(mode == 3)
   {
      mode = 1;
   }
   else if(mode == 1)
   {
      mode = 0;
   }
   else
   {
      mode = 0;
      puerto_d = 0x00;
   }
   actualizar_lcd = 1;
}

void funcion_siguiente(void)
{
   if(armado == 1 && boton_valido(siguiente))
   {
      estado++;
      if(estado > 7) { estado = 1; }
      view();
      while(input(siguiente) == 0);
      delay_ms(30);
   }
}

void funcion_anterior(void)
{
   if(armado == 1 && boton_valido(anterior))
   {
      estado--;
      if(estado < 1) { estado = 7; }
      view();
      while(input(anterior) == 0);
      delay_ms(30);
   }
}

void funcion_enter(void)
{
   if(armado == 1 && boton_valido(enter))
   {
      mode = 3;
      actualizar_lcd = 1;
      while(input(enter) == 0);
      delay_ms(30);
   }
}

void funcion_confirmar(void)
{
   if(armado == 1 && boton_valido(confirmar))
   {
      mode = 2;
      actualizar_lcd = 1;
      while(input(confirmar) == 0);
      delay_ms(30);
   }
}

